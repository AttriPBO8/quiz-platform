# Copy to .env (or run `npm run setup`, which fills in random values for you).
# On AWS these are set under Amplify > Hosting > Environment variables.

# PostgreSQL connection string.
DATABASE_URL="postgresql://postgres:YOUR_DB_PASSWORD@localhost:5432/quizportal"

# Signs login sessions. At least 32 random characters. Changing it signs everyone out.
SESSION_SECRET=""

# Encrypts stored passwords so admins can view them. 32 random bytes, base64.
# Keep a safe copy: if it is lost, stored passwords can no longer be shown (logins still work).
PASSWORD_ENCRYPTION_KEY=""

# Starting password for quiz-takers added without one. Letters and numbers.
DEFAULT_USER_PASSWORD=""

# Password given to the sample admin accounts by `npm run db:seed`.
SEED_ADMIN_PASSWORD=""
